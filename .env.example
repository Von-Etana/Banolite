# -----------------------------------------------------------------------------
# Banolite Production Environment Configuration Template
# Duplicate this file to .env.local for local development, or configure these
# environment variables in your Vercel project dashboard.
# -----------------------------------------------------------------------------

# Application URL
NEXT_PUBLIC_APP_URL=https://banolite.com

# Supabase Configurations
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection Strings (Prisma / Direct Access)
DATABASE_URL="postgresql://postgres.your-project-id:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Resend Email Service Configuration
# Get from: https://resend.com
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Paystack Payment Gateway Configuration
# Get from: https://dashboard.paystack.com -> Settings -> API Keys
PAYSTACK_SECRET_KEY=sk_live_your_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key

# Cron Job Security (For webhook worker queue & reconciliation)
# Generate a strong secure random key: e.g., openssl rand -base64 32
CRON_SECRET=your_production_cron_secret_here

# Upstash Redis (Optional for caching and rate limiting)
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
